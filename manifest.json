{
  "manifest_version": 3,
  "name": "Watch Later Now",
  "version": "2.0.0",
  "description": "Browse, filter, search, and watch your entire YouTube Watch Later playlist.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "watch-now/data-store.js",
        "watch-now/filters.js",
        "watch-now/video-grid.js",
        "watch-now/scanner.js",
        "watch-now/page-renderer.js",
        "content-script.js"
      ],
      "css": ["styles/watch-now.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
